---
import Mainlayout from '../layouts/Mainlayout.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
---

<Mainlayout title="Propuestas Inclusivas - Un colegio para todos y todas">
  <!-- Cabecera de la Página -->
  <section class="hero-section" aria-labelledby="propuestas-hero-title">
    <h1 id="propuestas-hero-title">Propuestas para un Colegio Inclusivo</h1>
    <p class="subtitle">Estrategias y soluciones para eliminar las barreras del aprendizaje</p>
    <p class="description">
      Transformar un establecimiento educacional en un espacio plenamente inclusivo requiere acciones organizadas que involucren la infraestructura, la metodología pedagógica y la cultura escolar.
    </p>

    <!-- Enlaces de navegación rápida -->
    <div class="nav-links-banner">
      <Button text="Inicio" href="/" ariaLabel="Ir a la página de inicio" />
      <Button text="Información General" href="/info" ariaLabel="Ir a la página de información" />
      <Button text="Barreras Educativas" href="/barreras" ariaLabel="Ir a la página de barreras educativas" />
    </div>
  </section>

  <!-- Pilar 1: Adaptación de Infraestructura -->
  <section class="info-block" aria-labelledby="infra-title">
    <h2 id="infra-title">1. Adaptación de Infraestructura y Accesibilidad Física</h2>
    <p class="block-intro">
      Garantizar que todos los estudiantes y miembros de la comunidad puedan desplazarse de manera autónoma y segura por el colegio:
    </p>
    <div class="grid">
      <Card 
        title="Rampas y Ascensores" 
        description="Construcción de rampas con pendiente adecuada y pasamanos dobles, así como elevadores en edificios de múltiples pisos." 
      />
      <Card 
        title="Señaletica Accesible" 
        description="Instalación de señalización en relieve y Braille, junto con franjas podotáctiles en pisos para estudiantes con discapacidad visual." 
      />
      <Card 
        title="Servicios Adaptados" 
        description="Habilitación de baños accesibles con barras de apoyo, puertas anchas y lavamanos a alturas adecuadas." 
      />
    </div>
  </section>

  <!-- Pilar 2: Estrategias Pedagógicas -->
  <section class="info-block" aria-labelledby="pedagogia-title">
    <h2 id="pedagogia-title">2. Estrategias Pedagógicas y Capacitación Docente</h2>
    <p class="block-intro">
      Flexibilizar la enseñanza para atender a los diversos ritmos y estilos de aprendizaje en el aula:
    </p>
    <ul class="proposals-list">
      <li>
        <strong>Diseño Universal para el Aprendizaje:</strong> Planificar clases que ofrezcan múltiples formas de presentación de la información y evaluación.
      </li>
      <li>
        <strong>Materiales didácticos diversos:</strong> Incorporar textos en lectura fácil, macrotipo, audiolibros y recursos digitales interactivos.
      </li>
      <li>
        <strong>Capacitación continua a profesores:</strong> Talleres formativos periódicos en neurodiversidad y metodologías evaluativas flexibles.
      </li>
    </ul>
  </section>

  <!-- Pilar 3: Cultura Escolar -->
  <section class="info-block" aria-labelledby="convivencia-title">
    <h2 id="convivencia-title">3. Cultura Escolar, Empatía y Convivencia</h2>
    <p class="block-intro">
      Promover un ambiente acogedor que prevenga el acoso escolar y la discriminación:
    </p>
    <div class="grid">
      <Card 
        title="Programa de Tutorías" 
        description="Sistema de compañeros tutores donde estudiantes se brindan apoyo académico y social mutuo." 
      />
      <Card 
        title="Talleres de Empatía" 
        description="Jornadas de sensibilización sobre diversidad cultural, neurodivergencia y distintas capacidades." 
      />
      <Card 
        title="Semanas de la Inclusión" 
        description="Eventos culturales y deportivos adaptados para integrar a toda la comunidad escolar." 
      />
    </div>

    <div class="section-link">
      <a href="/barreras" class="text-link">&larr; Revisa las Barreras Educativas que buscamos resolver</a>
    </div>
  </section>

  <!-- Cierre Destacado -->
  <section class="final-action-box" aria-labelledby="action-title">
    <h2 id="action-title">La inclusión es tarea de todos</h2>
    <p>
      Cada pequeña acción en el aula y en los patios nos acerca a una educación donde cada estudiante cuenta y aporta.
    </p>
    <div class="buttons-container">
      <Button text="Ir al Inicio" href="/" ariaLabel="Ir a la página de inicio" />
      <Button text="Volver a Información" href="/info" ariaLabel="Ir a la página de información general" />
      <Button text="Ver Barreras Educativas" href="/barreras" ariaLabel="Ir a la página de barreras educativas" />
    </div>
  </section>
</Mainlayout>

<style>
  /* Hero Hermético y Vibrante */
  .hero-section {
    background-color: #0f172a;
    border: 3px solid #38bdf8;
    border-radius: 12px;
    margin-top: 32px;
    padding: 40px 24px;
    text-align: center;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.2);
  }

  .hero-section h1 {
    font-size: 34px;
    color: #ffffff;
    margin-bottom: 8px;
    line-height: 42px;
    font-weight: 800;
  }

  .subtitle {
    font-size: 20px;
    font-weight: 700;
    color: #fbbf24;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .description {
    font-size: 17px;
    color: #f1f5f9;
    max-width: 800px;
    margin: 0 auto 24px auto;
    line-height: 26px;
  }

  .nav-links-banner {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  /* Bloques de Información */
  .info-block {
    margin-top: 36px;
    background-color: #ffffff;
    border: 3px solid #1e293b;
    border-radius: 10px;
    padding: 32px 28px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .info-block h2 {
    font-size: 24px;
    color: #1e1b4b;
    margin-bottom: 18px;
    border-bottom: 3px solid #6366f1;
    padding-bottom: 10px;
    font-weight: 800;
  }

  .block-intro {
    font-size: 16px;
    color: #0f172a;
    line-height: 26px;
    margin-bottom: 20px;
  }

  /* Listas estructuradas con marco lateral */
  .proposals-list {
    padding-left: 0;
    list-style-type: none;
  }

  .proposals-list li {
    font-size: 16px;
    color: #1e293b;
    margin-bottom: 14px;
    line-height: 24px;
    padding: 12px 16px;
    background-color: #f8fafc;
    border-left: 4px solid #6366f1;
    border-radius: 4px;
  }

  .proposals-list strong {
    color: #312e81;
  }

  .section-link {
    margin-top: 20px;
    text-align: right;
  }

  .text-link {
    color: #4338ca;
    font-weight: 800;
    font-size: 16px;
    text-decoration: none;
  }

  .text-link:hover, .text-link:focus {
    color: #1e1b4b;
    text-decoration: underline;
  }

  /* Bloque de cierre */
  .final-action-box {
    background-color: #1e1b4b;
    border: 3px solid #fbbf24;
    border-radius: 12px;
    padding: 36px 24px;
    margin-top: 40px;
    margin-bottom: 48px;
    text-align: center;
  }

  .final-action-box h2 {
    font-size: 26px;
    color: #ffffff;
    margin-bottom: 14px;
    font-weight: 800;
  }

  .final-action-box p {
    font-size: 18px;
    font-weight: 600;
    color: #fef08a;
    max-width: 800px;
    margin: 0 auto 28px auto;
    line-height: 28px;
  }

  .buttons-container {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .hero-section {
      padding: 28px 16px;
    }

    .hero-section h1 {
      font-size: 26px;
      line-height: 34px;
    }

    .subtitle {
      font-size: 17px;
    }

    .info-block {
      padding: 22px 16px;
    }

    .section-link {
      text-align: center;
    }
  }
</style>